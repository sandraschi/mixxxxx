# Probe ONNX Runtime + stem_separator compile (TODO 31).
# Requires: x64 Native Tools Command Prompt, existing build/ with vcpkg toolchain.

param(
    [string]$BuildDir = "build",
    [switch]$FullBuild
)

$ErrorActionPreference = "Stop"
$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$repoRoot = Split-Path -Parent $scriptDir
$buildPath = Join-Path $repoRoot $BuildDir

if (-not (Test-Path $buildPath)) {
    Write-Error "Missing $buildPath — configure mixxxxx first (see docs/INSTALLER.md)."
}

$vcpkgToolchain = Get-ChildItem -Path (Join-Path $repoRoot "buildenv") -Recurse -Filter "vcpkg.cmake" -ErrorAction SilentlyContinue |
    Select-Object -First 1
if (-not $vcpkgToolchain) {
    Write-Warning "vcpkg.cmake not found under buildenv/ — run tools\windows_release_buildenv.bat if configure fails."
}

Push-Location $buildPath
try {
    Write-Host "Reconfiguring with -DONNX_RUNTIME=ON ..."
    $cmakeArgs = @("-DONNX_RUNTIME=ON", "-DMIXXXXX_BRANDING=ON", ".")
    if ($vcpkgToolchain) {
        $cmakeArgs = @(
            "-DONNX_RUNTIME=ON",
            "-DMIXXXXX_BRANDING=ON",
            "-DCMAKE_TOOLCHAIN_FILE=$($vcpkgToolchain.FullName)",
            "-DVCPKG_TARGET_TRIPLET=x64-windows-release",
            "."
        )
    }
    & cmake @cmakeArgs
    if ($LASTEXITCODE -ne 0) { throw "cmake configure failed" }

    $target = if ($FullBuild) { "mixxx" } else { "mixxx-lib" }
    Write-Host "Building $target ..."
    & ninja $target
    if ($LASTEXITCODE -ne 0) { throw "ninja $target failed" }

    $dll = Join-Path $buildPath "onnxruntime.dll"
    $libDll = Join-Path $buildPath "mixxx-lib.dll"
    if (Test-Path $dll) {
        Write-Host "OK: onnxruntime.dll present at $dll"
    }
    else {
        Write-Warning "onnxruntime.dll not in build root — check POST_BUILD copy on mixxx-lib"
    }

    $stemObj = Get-ChildItem -Path $buildPath -Recurse -Filter "stem_separator.cpp.obj" -ErrorAction SilentlyContinue |
        Select-Object -First 1
    if ($stemObj) {
        Write-Host "OK: stem_separator object compiled: $($stemObj.FullName)"
    }
    else {
        Write-Warning "stem_separator.cpp.obj not found — ONNX block may not have activated"
    }

    Write-Host "`nProbe complete. See docs/STEMS-ONNX-PROBE.md for next steps."
}
finally {
    Pop-Location
}
